COMPOSE_PROJECT_NAME=geodock

MODE=hybrid

# Server DNS name (also used to generate a self-signed certificate if no certs are mounted)
# Use an internal FQDN (avoid .local): e.g. geodock.intra
SERVER_NAME=geodock.intra

# Official remote upstream
UPSTREAM_BAN=https://api-adresse.data.gouv.fr
UPSTREAM_HOST=api-adresse.data.gouv.fr
LOCAL_UPSTREAM=http://geocoder-api:3000

# Host ports (defaults 80/443)
HOST_PORT_HTTP=80
HOST_PORT_HTTPS=443

# TLS protocols
SSL_PROTOCOLS=TLSv1.2 TLSv1.3
UPSTREAM_SSL_PROTOCOLS=TLSv1.3

# Fallback behavior
FALLBACK_ON_404=false

# Redirect HTTP (80) to HTTPS (443)
REDIRECT_HTTP_TO_HTTPS=false

# Expose /_health on HTTP (80)
EXPOSE_HEALTH_ON_HTTP=true

# GeoDock V2 install source
GEODOCK_USE_GHCR=true
GEODOCK_PROXY_IMAGE=ghcr.io/jbjardine/geodock-proxy:latest
GEODOCK_RUNTIME_IMAGE=ghcr.io/jbjardine/geodock-runtime:latest

# Local runtime source
# - build   : build indexes locally from public data sources
# - archive : advanced compatibility mode using direct archive URLs
LOCAL_SOURCE=build

# Local coverage
# - departements : comma-separated list below
# - france       : full France coverage
LOCAL_SCOPE=departements
LOCAL_DEPARTEMENTS=75,92,93,94

# Local bootstrap/update behavior
LOCAL_AUTO_UPDATE=true
LOCAL_UPDATE_SCHEDULE_CRON=0 3 * * 1
LOCAL_BOOTSTRAP_TIMEOUT=86400

# Official upstream build of gpf-geocodeur (used if GHCR images are unavailable)
GEOCODER_GIT_URL=https://github.com/Geoplateforme/gpf-geocodeur.git
GEOCODER_GIT_REF=main

# Advanced compatibility mode only.
# Leave empty for the standard GeoDock V2 experience.
ADDRESS_ARCHIVE_URL=
PARCEL_ARCHIVE_URL=
POI_ARCHIVE_URL=
ADDRESS_ARCHIVE_URL_RESOLVER=
PARCEL_ARCHIVE_URL_RESOLVER=
POI_ARCHIVE_URL_RESOLVER=

# Optional runtime tuning for large POI archives.
# Keep 1 unless you have validated a higher value on your target machine.
POI_ADDOK_CLUSTER_NUM_NODES=1

# Optional ops tuning
WATCH_INTERVAL=3600
