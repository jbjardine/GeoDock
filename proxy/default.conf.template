# Generated from env at container start

resolver 127.0.0.11 ipv6=off;

server {
  listen 80 default_server reuseport;
  server_name ${SERVER_NAME};
  server_tokens off;
  client_max_body_size 20m;

  set $upstream_host "${UPSTREAM_HOST}";
  set $mode "${MODE}";
  set $expose_health_http "${EXPOSE_HEALTH_ON_HTTP}";

  proxy_http_version 1.1;
  proxy_set_header Host $upstream_host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header Accept "";
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header Cookie "";
  proxy_hide_header Set-Cookie;
  proxy_ssl_server_name on;
  proxy_ssl_name $upstream_host;
  proxy_ssl_protocols ${UPSTREAM_SSL_PROTOCOLS};
  proxy_send_timeout 30s;
  proxy_read_timeout 30s;
  proxy_connect_timeout 5s;
  proxy_intercept_errors on;

  location = /_health {
    if ($expose_health_http = "true") {
      add_header Content-Type application/json;
      return 200 '{"status":"ok","mode":"${MODE}"}';
    }
    return 301 https://$host$request_uri;
  }

  location = /_status {
    default_type application/json;
    add_header Cache-Control "no-store" always;
    alias /var/lib/geodock/status.json;
  }

  location / {
    set $redir "${REDIRECT_HTTP_TO_HTTPS}";
    if ($redir = "true") { return 301 https://$host$request_uri; }

    if ($request_method = 'OPTIONS') {
      add_header Access-Control-Allow-Origin *;
      add_header Access-Control-Allow-Methods "GET, OPTIONS";
      add_header Access-Control-Allow-Headers "*";
      return 204;
    }

    add_header Access-Control-Allow-Origin *;
    add_header Server "" always;
    add_header X-Geodock-Mode $mode always;
    add_header X-Geodock-Upstream ${PRIMARY_UPSTREAM_LABEL} always;

    proxy_pass ${PRIMARY_UPSTREAM}$request_uri;
    ${FALLBACK_5XX_DIRECTIVE}
    ${FALLBACK_404_DIRECTIVE}
  }

  location @remote_fallback {
    add_header Access-Control-Allow-Origin *;
    add_header Server "" always;
    add_header X-Geodock-Mode $mode always;
    add_header X-Geodock-Upstream remote always;
    proxy_pass ${UPSTREAM_BAN}$request_uri;
  }

  location @local_fallback {
    add_header Access-Control-Allow-Origin *;
    add_header Server "" always;
    add_header X-Geodock-Mode $mode always;
    add_header X-Geodock-Upstream local always;
    proxy_pass ${LOCAL_UPSTREAM}$request_uri;
  }
}

server {
  listen 443 ssl default_server reuseport;
  server_name ${SERVER_NAME};
  http2 on;
  server_tokens off;
  client_max_body_size 20m;

  ssl_certificate     /etc/nginx/certs/tls.crt;
  ssl_certificate_key /etc/nginx/certs/tls.key;
  ssl_session_cache   shared:SSL:10m;
  ssl_session_timeout 10m;
  ssl_prefer_server_ciphers on;
  ssl_protocols ${SSL_PROTOCOLS};

  set $upstream_host "${UPSTREAM_HOST}";
  set $mode "${MODE}";

  proxy_http_version 1.1;
  proxy_set_header Host $upstream_host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header Accept "";
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header Cookie "";
  proxy_hide_header Set-Cookie;
  proxy_ssl_server_name on;
  proxy_ssl_name $upstream_host;
  proxy_ssl_protocols ${UPSTREAM_SSL_PROTOCOLS};
  proxy_send_timeout 30s;
  proxy_read_timeout 30s;
  proxy_connect_timeout 5s;
  proxy_intercept_errors on;

  location = /_health {
    add_header Content-Type application/json;
    return 200 '{"status":"ok","mode":"${MODE}"}';
  }

  location = /_status {
    default_type application/json;
    add_header Cache-Control "no-store" always;
    alias /var/lib/geodock/status.json;
  }

  location / {
    if ($request_method = 'OPTIONS') {
      add_header Access-Control-Allow-Origin *;
      add_header Access-Control-Allow-Methods "GET, OPTIONS";
      add_header Access-Control-Allow-Headers "*";
      return 204;
    }

    add_header Access-Control-Allow-Origin *;
    add_header Server "" always;
    add_header X-Geodock-Mode $mode always;
    add_header X-Geodock-Upstream ${PRIMARY_UPSTREAM_LABEL} always;

    proxy_pass ${PRIMARY_UPSTREAM}$request_uri;
    ${FALLBACK_5XX_DIRECTIVE}
    ${FALLBACK_404_DIRECTIVE}
  }

  location @remote_fallback {
    add_header Access-Control-Allow-Origin *;
    add_header Server "" always;
    add_header X-Geodock-Mode $mode always;
    add_header X-Geodock-Upstream remote always;
    proxy_pass ${UPSTREAM_BAN}$request_uri;
  }

  location @local_fallback {
    add_header Access-Control-Allow-Origin *;
    add_header Server "" always;
    add_header X-Geodock-Mode $mode always;
    add_header X-Geodock-Upstream local always;
    proxy_pass ${LOCAL_UPSTREAM}$request_uri;
  }
}
