# syntax=docker/dockerfile:1.7
FROM redis:8.0-bookworm AS redis

FROM python:3.11-slim-bookworm

ARG GEOCODER_GIT_URL=https://github.com/Geoplateforme/gpf-geocodeur.git
ARG GEOCODER_GIT_REF=main

ENV PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    NODE_ENV=production \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TMP_PATH=/tmp \
    DATA_PATH=/data \
    PORT=3000

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       bash \
       build-essential \
       ca-certificates \
       curl \
       gdal-bin \
       git \
       libgdal-dev \
       p7zip-full \
       wget \
    && curl -fsSL https://deb.nodesource.com/setup_18.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY --from=redis /usr/local/bin/redis-server /usr/local/bin/redis-server

RUN corepack enable && corepack prepare yarn@1.22.22 --activate

RUN python -m ensurepip --upgrade \
    && python -m pip install --no-cache-dir --upgrade pip setuptools wheel

WORKDIR /opt

RUN git clone --depth 1 --branch "${GEOCODER_GIT_REF}" "${GEOCODER_GIT_URL}" geocodeur

WORKDIR /opt/geocodeur

RUN python -m pip install --no-cache-dir -r requirements.txt \
    # Addok still imports pkg_resources at runtime; setuptools 81+ no longer ships it.
    && python -m pip install --no-cache-dir 'setuptools<81' \
    && yarn install --frozen-lockfile --production

EXPOSE 3000

CMD ["yarn", "api:start"]
